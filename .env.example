# Docker Compose variables. Copy this file to .env and replace every value.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-at-least-32-random-characters

# DingTalk write credentials. Leave blank to test local check-in only.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ACCESS_TOKEN=
DINGTALK_DEVICE_NAME=外部系统同步
DINGTALK_DEVICE_ID=manual_sync_001
DINGTALK_UPLOAD_FORMAT=form
DINGTALK_SYNC_USERS_ON_START=true
DINGTALK_ROOT_DEPT_ID=1
# DINGTALK_PROXY_URL=

# Host port mapped to the app container's port 8080.
APP_PORT=8080
TZ=Asia/Shanghai
